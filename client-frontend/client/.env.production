# Loaded automatically by `npm run build`. MUST stay committed —
# without it, a production build falls back to localhost and the
# deployed site breaks.
#
# These URLs are baked into dist/ and are publicly visible. That is
# expected. Never add a secret to this file.
VITE_CLIENT_API_BASE=https://pai-silks-website-1.onrender.com
VITE_ADMIN_API_BASE=https://pai-silks-website.onrender.com
