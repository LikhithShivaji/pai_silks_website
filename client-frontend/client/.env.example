# Copy to .env for local development:  cp .env.example .env
#
# VITE_* values are substituted at build time and are PUBLIC in the
# shipped bundle. Never put secrets here.

# Customer backend (auth, cart, wishlist, orders, products)
VITE_CLIENT_API_BASE=http://localhost:9034

# Admin backend — the storefront currently reads its product catalogue
# from here. Known defect, see CLAUDE.md CF-22.
VITE_ADMIN_API_BASE=http://localhost:9032
