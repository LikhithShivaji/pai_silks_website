# Copy to .env for local development:  cp .env.example .env
#
# VITE_* values are substituted at build time and are PUBLIC in the
# shipped bundle. Never put secrets here.

# Admin backend (products, orders, categories, images)
VITE_ADMIN_API_BASE=http://localhost:9032

# Customer backend — the admin panel reads bestsellers and collections
# from it. See CLAUDE.md AF-07.
VITE_CLIENT_API_BASE=http://localhost:9034
