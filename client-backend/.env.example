# Copy to .env for local development:  cp .env.example .env
#
# Key names only — never commit real values. The actual .env is gitignored.
# In production these are set in the Render dashboard
# (Service -> Environment), NOT by uploading a file. See DEPLOYMENT.md.
#
# NOTE: this service currently has NO .env file at all, so the hardcoded
# fallbacks in src/config/db.js (root / admin123 / db) are what actually
# runs. Create a real .env before AB-06/CB-10 remove those fallbacks.

# --- Server ---
PORT=9034
NODE_ENV=development

# --- CORS ---
# Comma-separated list of browser origins allowed to call this API.
#
# PRODUCTION value to set in the Render dashboard:
#   CORS_ORIGINS=https://paisilks.com,https://admin.paisilks.com
#
# Both are required: paisilks.com is the storefront, and the admin panel at
# admin.paisilks.com also reads bestsellers and collections from this
# service — see CLAUDE.md AF-07.
#
# Add https://www.paisilks.com too if the site is served from www rather
# than redirecting to the apex domain.
#
# Leaving this unset in production means only localhost is allowed and the
# browser will block the live site.
CORS_ORIGINS=http://localhost:9031,http://localhost:9033

# --- Database ---
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=db
DB_PORT=3306

# --- Auth (added in Phase 2) ---
# Long random string. Generate with:  openssl rand -hex 32
JWT_SECRET=
