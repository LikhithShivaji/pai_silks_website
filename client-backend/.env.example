# Copy to .env for local development:  cp .env.example .env
#
# Key names only — never commit real values. The actual .env is gitignored.
# In production these are set in the Render dashboard
# (Service -> Environment), NOT by uploading a file. See DEPLOYMENT.md.
#
# NOTE: this service currently has NO .env file at all, so the hardcoded
# fallbacks in src/config/db.js (root / admin123 / db) are what actually
# runs. Create a real .env before AB-06/CB-10 remove those fallbacks.

# --- Server ---
PORT=9034
NODE_ENV=development

# --- Database ---
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=db
DB_PORT=3306

# --- Auth (added in Phase 2) ---
# Long random string. Generate with:  openssl rand -hex 32
JWT_SECRET=
