# Copy to .env for local development:  cp .env.example .env
#
# Key names only — never commit real values. The actual .env is gitignored.
# In production these are set in the Render dashboard
# (Service -> Environment), NOT by uploading a file. See DEPLOYMENT.md.

# --- Server ---
PORT=9032
NODE_ENV=development

# --- CORS ---
# Comma-separated list of browser origins allowed to call this API.
#
# PRODUCTION value to set in the Render dashboard:
#   CORS_ORIGINS=https://admin.paisilks.com,https://paisilks.com
#
# Both are required: admin.paisilks.com is the admin panel, and
# paisilks.com (the storefront) also reads its product catalogue from this
# service — see CLAUDE.md CF-22. Once CF-22 re-points the storefront at
# client-backend, https://paisilks.com can be dropped from this list.
#
# Add https://www.paisilks.com too if the site is served from www rather
# than redirecting to the apex domain.
#
# Leaving this unset in production means only localhost is allowed and the
# browser will block the live site.
CORS_ORIGINS=http://localhost:9031,http://localhost:9033

# --- Database ---
# src/config/db.js currently falls back to root/admin123/db when these are
# unset, which means the fallback is the live config. Removing that fallback
# is CLAUDE.md AB-06 (Phase 1) — these vars must exist before it lands.
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=db
DB_PORT=3306

# --- Auth (added in Phase 2) ---
# Long random string. Generate with:  openssl rand -hex 32
JWT_SECRET=

# --- Cloudinary ---
# ROTATE THESE. The previous values were committed to a public repo in
# 8f8cb01 and must be treated as compromised. See CLAUDE.md SEC-01.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
